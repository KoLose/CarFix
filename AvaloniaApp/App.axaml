<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApp.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
             
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Material.Icons.Avalonia/MaterialIconStyles.xaml" />
        <StyleInclude Source="/Styles/Styles.axaml"/>
        
        <StyleInclude Source="/Styles/Auth/Auth.axaml"/>
        <StyleInclude Source="/Styles/Auth/Login.axaml"/>
        <StyleInclude Source="/Styles/Auth/Sidebar.axaml"/>
        
        <StyleInclude Source="/Styles/LayoutComponents/Header.axaml"></StyleInclude>
        <StyleInclude Source="/Styles/LayoutComponents/Sidebar.axaml"></StyleInclude>
    </Application.Styles>
</Application>