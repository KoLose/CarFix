<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApp.Pages.Auth.LoginUC">
    
    <Border Classes="Auth-container">
        <StackPanel Spacing="15" Width="250">
            <TextBox x:Name="LoginBox" PlaceholderText="L o g i n"/>
            <TextBox x:Name="PasswordBox" PlaceholderText="P a s s w o r d"/>
            <Button Click="LoginBtn" Content="S i g n  I n" Classes="Button-UI"/>
        </StackPanel>
    </Border>
</UserControl>
