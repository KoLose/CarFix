<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApp.Pages.Profile">
    <Border Padding="30">
        <StackPanel Width="360" Spacing="12" HorizontalAlignment="Left">
            <TextBlock Text="Профиль" Classes="PageTitle"/>
            <TextBlock Text="Имя" Classes="TextBlock-UI"/>
            <TextBox x:Name="NameBox" Classes="FormBox"/>
            <TextBlock Text="Логин" Classes="TextBlock-UI"/>
            <TextBox x:Name="LoginBox" Classes="FormBox"/>
            <TextBlock Text="Пароль" Classes="TextBlock-UI"/>
            <TextBox x:Name="PasswordBox" Classes="FormBox"/>
            <Button Content="Сохранить" Classes="Button-UI" Click="SaveClick" Margin="0,10,0,0"/>
            <TextBlock x:Name="StatusText" Classes="TextBlock-UI" Foreground="#7a7a96"/>
        </StackPanel>
    </Border>
</UserControl>
