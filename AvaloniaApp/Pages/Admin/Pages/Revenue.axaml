<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApp.Pages.Admin.Pages.Revenue">
    <Border Padding="30">
        <StackPanel Spacing="16" Width="420" HorizontalAlignment="Left">
            <TextBlock Text="Выручка" Classes="PageTitle"/>
            <TextBlock x:Name="PaymentsText" Classes="TextBlock-UI" FontSize="16"/>
            <TextBlock x:Name="PartsText" Classes="TextBlock-UI" FontSize="16"/>
            <Border Height="1" Background="#7a7a96"/>
            <TextBlock x:Name="ProfitText" Classes="TextBlock-UI" FontSize="20" FontWeight="SemiBold"/>
            <Button Content="Обновить" Classes="Button-UI" Click="RefreshClick" Width="160" HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</UserControl>
