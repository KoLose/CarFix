<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApp.Pages.Manager.Pages.Schedule">
    <Border Padding="24">
        <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Text="Расписание (Пн–Пт, Утро/Вечер)" Classes="PageTitle"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                <ComboBox x:Name="MechanicBox" Width="220">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Заменить механика в слоте" Classes="Button-UI" Width="240" Click="ReplaceClick"/>
            </StackPanel>
            <DataGrid x:Name="Grid" Grid.Row="2"
                      IsReadOnly="True"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="День" Binding="{Binding DayOfWeek}" Width="80"/>
                    <DataGridTextColumn Header="Смена" Binding="{Binding Name}" Width="100"/>
                    <DataGridTextColumn Header="Механик" Binding="{Binding User.Name}" Width="*"/>
                    <DataGridTextColumn Header="UserId" Binding="{Binding UserId}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
