<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApp.Pages.Manager.Pages.Mechanics">
    <Border Padding="24">
        <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Text="Механики" Classes="PageTitle"/>
            <Button Grid.Row="1" Content="Уволить выбранного" Classes="Button-UI"
                    Width="220" HorizontalAlignment="Left" Margin="0,0,0,16" Click="FireClick"/>
            <DataGrid x:Name="Grid" Grid.Row="2"
                      IsReadOnly="True"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
