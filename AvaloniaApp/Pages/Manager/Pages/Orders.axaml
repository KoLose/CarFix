<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApp.Pages.Manager.Pages.Orders">
    <Border Padding="24">
        <Grid RowDefinitions="Auto,*">
            <TextBlock Text="Заказы (двойной клик — детали)" Classes="PageTitle"/>
            <DataGrid x:Name="Grid" Grid.Row="1"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      DoubleTapped="OnDoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding DateCreated}" Width="160"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status.Name}" Width="120"/>
                    <DataGridTextColumn Header="Авто" Binding="{Binding Automobile.Brand}" Width="100"/>
                    <DataGridTextColumn Header="Модель" Binding="{Binding Automobile.Model}" Width="100"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding Automobile.Client.Name}" Width="140"/>
                    <DataGridTextColumn Header="Механик" Binding="{Binding Mechanic.Name}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
