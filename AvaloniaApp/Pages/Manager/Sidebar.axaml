<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="90" d:DesignHeight="768"
             x:Class="AvaloniaApp.Pages.Manager.Sidebar"
             Background="#070715">
    
        <StackPanel Orientation="Vertical" Spacing="80" Margin="0,40,0,0">
            
            <avalonia:MaterialIcon Kind="Car" 
                                   Width="40" 
                                   Foreground="#7a7a96"
                                   Margin="0,0,0,80"
                                   HorizontalAlignment="Center"/>
            
            <avalonia:MaterialIcon Kind="AccountGroup" 
                                   Width="30" 
                                   Classes="clickable"
                                   Foreground="#7a7a96"
                                   HorizontalAlignment="Center"
                                   ToolTip.Tip="Клиенты"/>
            
            <avalonia:MaterialIcon Kind="CalendarClock" 
                                   Width="30" 
                                   Classes="clickable"
                                   Foreground="#7a7a96"
                                   HorizontalAlignment="Center"
                                   ToolTip.Tip="Записи"/>
            
            <avalonia:MaterialIcon Kind="Tools" 
                                   Width="30" 
                                   Classes="clickable"
                                   Foreground="#7a7a96"
                                   HorizontalAlignment="Center"
                                   ToolTip.Tip="Механики"/>
            
            <avalonia:MaterialIcon Kind="Account" 
                                   Width="30" 
                                   Classes="clickable"
                                   Foreground="#7a7a96"
                                   HorizontalAlignment="Center"
                                   Margin="0,470,0,0"
                                   ToolTip.Tip="Профиль"/>
            
        </StackPanel>
</UserControl>