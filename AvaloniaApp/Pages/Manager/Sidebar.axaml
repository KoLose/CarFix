<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="90" d:DesignHeight="768"
             x:Class="AvaloniaApp.Pages.Manager.Sidebar"
             Background="#070715">
    
    <StackPanel Orientation="Vertical" Spacing="25" Margin="0,80,0,0">
        
        <avalonia:MaterialIcon Kind="Car" 
                               Width="40" 
                               Foreground="#7a7a96"
                               Margin="0,0,0,80"
                               HorizontalAlignment="Center"/>
            
        <Border Height="1" Width="60" Background="#7a7a96" Margin="0,10"/>
        
        <avalonia:MaterialIcon Kind="AccountGroup" 
                               Width="30" 
                               Classes="clickable"
                               Foreground="#7a7a96"
                               HorizontalAlignment="Center"
                               ToolTip.Tip="Клиенты"
                               Tag="Clients"/>
            
        <Border Height="1" Width="60" Background="#7a7a96" Margin="0,10"/>
        
        <avalonia:MaterialIcon Kind="CarMultiple" 
                               Width="30" 
                               Classes="clickable"
                               Foreground="#7a7a96"
                               HorizontalAlignment="Center"
                               ToolTip.Tip="Машины"
                               Tag="Cars"/>
            
        <Border Height="1" Width="60" Background="#7a7a96" Margin="0,10"/>
        
        <avalonia:MaterialIcon Kind="ClipboardText" 
                               Width="30" 
                               Classes="clickable"
                               Foreground="#7a7a96"
                               HorizontalAlignment="Center"
                               ToolTip.Tip="Заказы"
                               Tag="Orders"/>
            
        <Border Height="1" Width="60" Background="#7a7a96" Margin="0,10"/>
        
        <avalonia:MaterialIcon Kind="CalendarClock" 
                               Width="30" 
                               Classes="clickable"
                               Foreground="#7a7a96"
                               HorizontalAlignment="Center"
                               ToolTip.Tip="Расписание"
                               Tag="Schedule"/>

        <Border Height="1" Width="60" Background="#7a7a96" Margin="0,10"/>

        <avalonia:MaterialIcon Kind="Tools" 
                               Width="30" 
                               Classes="clickable"
                               Foreground="#7a7a96"
                               HorizontalAlignment="Center"
                               ToolTip.Tip="Механики"
                               Tag="Mechanics"/>
        
        <Border Height="1" Width="60" Background="#7a7a96" Margin="0,10"/>
        
        <avalonia:MaterialIcon Kind="Account" 
                               Width="30" 
                               Classes="clickable"
                               Foreground="#7a7a96"
                               HorizontalAlignment="Center"
                               Margin="0,180,0,0"
                               ToolTip.Tip="Профиль"
                               Tag="Profile"/>
            
    </StackPanel>
</UserControl>
