<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaApp.Pages.Manager.Windows.OrderDetailsWindow"
        Title="Детали заказа"
        Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#17172c">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Name="InfoText" Classes="TextBlock-UI" TextWrapping="Wrap"/>
        <TextBlock Text="Механик" Classes="TextBlock-UI"/>
        <ComboBox x:Name="MechanicBox">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock x:Name="ErrorText" Foreground="#ff8a8a" TextWrapping="Wrap"/>
        <Button Content="Назначить механика" Classes="Button-UI" Click="AssignClick"/>
        <TextBlock Text="Финальный отзыв клиента (после завершения)" Classes="TextBlock-UI" Margin="0,12,0,0"/>
        <TextBox x:Name="ReviewBox" Classes="FormBox" AcceptsReturn="True" Height="70"/>
        <Button Content="Сохранить отзыв клиента" Classes="Button-UI" Click="ReviewClick"/>
    </StackPanel>
</Window>
