<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="50"
             x:Class="AvaloniaApp.Pages.HeaderUC"
             Background="#1f1f39">
    
    <StackPanel Classes="Header-container-UI">
        
        <StackPanel Classes="Header-container-element-UI">
            <avalonia:MaterialIcon Kind="Build" 
                                   Width="30" 
                                   Classes="clickable"
                                   Foreground="#7a7a96"/>
            <TextBlock Text="S E R V I C E S" 
                       Classes="Header-TextBlock-UI"/>
        </StackPanel>
                               
        <StackPanel Classes="Header-container-element-UI">
            <avalonia:MaterialIcon Kind="Calendar" 
                                   Width="30" 
                                   Classes="clickable"
                                   Foreground="#7a7a96"/>
            <TextBlock Text="S L O T S"
                       Classes="Header-TextBlock-UI"/>
        </StackPanel>
        
    </StackPanel>
    
</UserControl>
