<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
        
        <Style Selector="Button.Button-UI">
                <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
                <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                <Setter Property="Foreground" Value="White"></Setter>
                <Setter Property="Background" Value="#2a2a48"></Setter>
                <Setter Property="Padding" Value="12,8"></Setter>
        </Style>
        
        <Style Selector="TextBlock.TextBlock-UI">
                <Setter Property="Foreground" Value="White"></Setter>
        </Style>

        <Style Selector="TextBlock.PageTitle">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style Selector="TextBox.FormBox">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#1f1f39"/>
                <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style Selector="DataGrid">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#17172c"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="BorderBrush" Value="#7a7a96"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        
        <Style Selector="Image.Logo-UI">
                <Setter Property="Width" Value="50"></Setter>
                <Setter Property="Height" Value="50"></Setter>
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>

        <Style Selector="avalonia|MaterialIcon.clickable">
                <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
</Styles>
